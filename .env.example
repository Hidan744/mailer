# --- База данных (Postgres поднимается в docker-compose, ничего скачивать не нужно) ---
POSTGRES_USER=mailer
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mailer
DATABASE_URL=postgresql://mailer:change-me-strong-password@localhost:5432/mailer

# --- Приложение ---
APP_PORT=3000
NODE_ENV=production
# Домен (поддомен), направленный A-записью на IP этого сервера — Caddy сам получит
# для него TLS-сертификат Let's Encrypt. Для локальной разработки не используется.
DOMAIN=mailer.вашдомен.рф
# Публичный URL, под которым приложение доступно (нужен для трекинг-пикселя и ссылки отписки в письмах)
PUBLIC_BASE_URL=https://mailer.вашдомен.рф

# --- Авторизация в админке ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Если пользователей в БД ещё нет — при первом запуске будет создан администратор
# с этими логином/паролем. Дальше можно создавать пользователей через
# npm run create-user -- <логин> <пароль>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# --- Шифрование паролей от почтовых ящиков в БД ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENC_KEY=

# --- Почтовый ящик отправки/приёма (SMTP/IMAP) ---
# Реквизиты вводятся оператором через админку (Настройки → Почтовый ящик) и хранятся в БД
# зашифрованными. Эти переменные — только для первичной настройки/тестового скрипта.
# Рекомендуемые провайдеры с серверами в РФ: Yandex 360 для бизнеса, VK WorkMail.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_SECURE=true
