// Схема БД для приложения веерной рассылки именных писем.
// Вся инфраструктура (эта БД, приложение, почтовый сервер) размещается на территории РФ.
//
// Мультитенантность: каждый клиент (Organization) видит только свои почтовые ящики,
// кампании, получателей и т.д. Суперадмин (User.isSuperAdmin) создаёт организации
// и их первых пользователей вручную через /admin — публичной регистрации нет.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  draft
  running
  paused_for_edit
  paused_manual
  done
}

enum LetterStatus {
  queued
  sent
  failed
  bounced
}

// Роль внутри организации: owner может управлять ящиками/бланками/схемами нумерации
// и пользователями организации, operator — только работать с кампаниями.
enum OrgRole {
  owner
  operator
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users               User[]
  campaigns           Campaign[]
  letterheadTemplates LetterheadTemplate[]
  numberingConfigs    NumberingConfig[]
  mailAccounts        MailAccountConfig[]
  suppressions        Suppression[]
  auditEvents         AuditEvent[]
}

model Campaign {
  id          String         @id @default(uuid())
  name        String
  status      CampaignStatus @default(draft)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subject     String
  bodyHtml    String

  // окно/скорость отправки — заполняются дефолтами из настроек, но переопределяемы для кампании
  sendWindowStart String    @default("09:00")
  sendWindowEnd   String    @default("17:00")
  lunchStart      String    @default("12:00")
  lunchEnd        String    @default("13:00")
  intervalMinutes Int       @default(5)
  timezone        String    @default("Asia/Yekaterinburg")

  // чек-пойнт ротации текста (п.5 ТЗ): каждые rotationThreshold писем — либо
  // автоматическое переключение на следующий вариант из textVariants (если их
  // заготовлено больше одного), либо, если вариантов нет, пауза на ручную правку
  rotationThreshold  Int    @default(75)
  sentSinceLastEdit  Int    @default(0)
  textVariants       Json?  // [{ subject, bodyHtml }, ...] — заготовленные заранее варианты
  activeVariantIndex Int    @default(0)

  letterheadId String?
  letterhead   LetterheadTemplate? @relation(fields: [letterheadId], references: [id])

  numberingId  String?
  numbering    NumberingConfig? @relation(fields: [numberingId], references: [id])

  mailAccountId String?
  mailAccount   MailAccountConfig? @relation(fields: [mailAccountId], references: [id])

  recipients  Recipient[]
  letters     Letter[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
}

model LetterheadTemplate {
  id            String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name          String
  headerImageUrl String?
  footerImageUrl String?
  footerContactsText String?
  createdAt     DateTime @default(now())
  campaigns     Campaign[]

  @@index([organizationId])
}

model Recipient {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  company        String
  position       String   // Должность: Директор / Генеральный директор / ...
  surnameInitials String  // Фамилия И.О. — для шапки
  fullNamePatronymic String // Имя Отчество — для обращения "Уважаемый ..."
  email          String

  extra          Json?    // произвольные доп. колонки из Excel

  // Ручной исходящий номер для этого получателя (например, у компании уже есть свой
  // номер входящего документа) — если задан, используется вместо автосчётчика схемы
  // нумерации и не расходует его. Пусто/null — обычная автонумерация, как раньше.
  manualOutgoingNumber String?

  letters        Letter[]

  createdAt      DateTime @default(now())

  @@index([campaignId])
}

model NumberingConfig {
  id           String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name         String
  template     String   @default("{prefix}/{counter}") // напр. "0210/{counter}"
  prefix       String   @default("")
  counter      Int      @default(1)
  resetPeriod  String   @default("never") // never | yearly
  lastResetYear Int?
  campaigns    Campaign[]

  @@index([organizationId])
}

model MailAccountConfig {
  id            String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name          String
  fromEmail     String
  fromName      String?

  smtpHost      String
  smtpPort      Int      @default(465)
  smtpSecure    Boolean  @default(true)
  smtpUser      String
  smtpPasswordEnc String // зашифровано, см. src/lib/crypto.ts

  imapHost      String?
  imapPort      Int?     @default(993)
  imapSecure    Boolean  @default(true)
  imapUser      String?
  imapPasswordEnc String?

  // Дневной лимит писем с этого ящика (суммарно по всем кампаниям, использующим его).
  // Пусто — без ограничения. Защита от случайного запуска нескольких крупных кампаний разом.
  dailyLimit    Int?

  createdAt     DateTime @default(now())
  campaigns     Campaign[]

  @@index([organizationId])
}

model Letter {
  id            String   @id @default(uuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId   String
  recipient     Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  outgoingNumber String?
  sentDate       String?
  messageId      String?  @unique
  trackingToken  String   @unique @default(uuid())

  status        LetterStatus @default(queued)
  errorMessage  String?

  subjectSnapshot String?
  bodySnapshot    String?

  queuedAt      DateTime @default(now())
  sentAt        DateTime?
  openedAt      DateTime?
  repliedAt     DateTime?
  bouncedAt     DateTime? // письмо не доставлено (получен отказ от почтового сервера получателя)

  @@index([campaignId])
  @@index([recipientId])
  @@index([status])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(owner)

  // Может заходить в /admin и создавать новые организации (сама платформа, не клиенты).
  isSuperAdmin Boolean @default(false)

  createdAt    DateTime @default(now())

  @@index([organizationId])
}

model Suppression {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  reason         String   @default("unsubscribed")
  createdAt      DateTime @default(now())

  @@unique([organizationId, email])
}

model AuditEvent {
  id        String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor     String   @default("system")
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([organizationId])
}
