<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Кампании</h1>
  <a href="/campaigns/new" class="btn btn-primary">+ Новая кампания</a>
</div>

<% if (campaigns.length === 0) { %>
  <p class="text-muted">Кампаний пока нет. Создайте первую — импортируйте получателей из Excel и настройте письмо.</p>
<% } else { %>
<table class="table table-hover bg-white">
  <thead>
    <tr>
      <th>Название</th>
      <th>Статус</th>
      <th>Получателей</th>
      <th>Отправлено</th>
      <th>Открыто</th>
      <th>Ответов</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% campaigns.forEach(function(c) { %>
    <tr>
      <td><a href="/campaigns/<%= c.id %>"><%= c.name %></a></td>
      <td><span class="badge badge-status-<%= c.status %>"><%= c.status %></span></td>
      <td><%= c._count.recipients %></td>
      <td><%= statsById[c.id].sent %></td>
      <td><%= statsById[c.id].opened %></td>
      <td><%= statsById[c.id].replied %></td>
      <td class="d-flex gap-1">
        <a href="/campaigns/<%= c.id %>" class="btn btn-sm btn-outline-secondary">Открыть</a>
        <a href="/campaigns/<%= c.id %>/edit" class="btn btn-sm btn-outline-secondary">Изменить</a>
        <form method="post" action="/campaigns/<%= c.id %>/delete" onsubmit="return confirm('Удалить кампанию «<%= c.name %>» вместе со всеми получателями и историей писем? Это необратимо.')">
          <button class="btn btn-sm btn-outline-danger">Удалить</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>
