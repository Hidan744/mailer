<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Рассылка именных писем</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">Рассылка писем</a>
      <div class="navbar-nav">
        <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Кампании</a>
        <a class="nav-link <%= currentPath.startsWith('/settings') ? 'active' : '' %>" href="/settings">Настройки</a>
      </div>
      <div class="d-flex align-items-center gap-2 ms-auto">
        <% if (typeof currentUsername !== 'undefined' && currentUsername) { %>
          <span class="navbar-text text-light small"><%= currentUsername %></span>
          <form method="post" action="/logout" class="m-0">
            <button class="btn btn-sm btn-outline-light">Выйти</button>
          </form>
        <% } %>
      </div>
    </div>
  </nav>
  <main class="container pb-5">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="alert alert-info"><%= flash %></div>
    <% } %>
    <%- body %>
  </main>
</body>
</html>
