<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Рассылка именных писем</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/favicon-180.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Yeseva+One&family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="/">
        <img class="brand-mark" src="/favicon.svg" alt="" width="32" height="32" />
        <span class="brand-text">Рассылка<em>писем</em></span>
      </a>
      <nav class="nav-links">
        <a class="nav-link <%= currentPath === '/' ? 'is-active' : '' %>" href="/">Кампании</a>
        <% if (currentRole === 'owner') { %>
          <a class="nav-link <%= currentPath.startsWith('/settings') ? 'is-active' : '' %>" href="/settings">Настройки</a>
        <% } %>
        <a class="nav-link <%= currentPath.startsWith('/audit') ? 'is-active' : '' %>" href="/audit">Журнал</a>
        <% if (isSuperAdmin) { %>
          <a class="nav-link <%= currentPath.startsWith('/admin') ? 'is-active' : '' %>" href="/admin">Организации</a>
        <% } %>
      </nav>
      <div class="topbar-user">
        <% if (typeof currentUsername !== 'undefined' && currentUsername) { %>
          <% if (typeof currentOrganizationName !== 'undefined' && currentOrganizationName) { %>
            <span class="user-chip"><%= currentOrganizationName %> · <%= currentUsername %></span>
          <% } else { %>
            <span class="user-chip"><%= currentUsername %></span>
          <% } %>
          <form method="post" action="/logout" class="m-0">
            <button class="btn-ghost">Выйти</button>
          </form>
        <% } %>
      </div>
    </div>
    <div class="topbar-rule"></div>
  </header>
  <main class="container page">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="alert alert-info"><%= flash %></div>
    <% } %>
    <%- body %>
  </main>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
