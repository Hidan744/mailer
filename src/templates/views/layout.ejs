<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Рассылка именных писем</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="/">
        <span class="brand-mark">№</span>
        <span class="brand-text">Рассылка<em>писем</em></span>
      </a>
      <nav class="nav-links">
        <a class="nav-link <%= currentPath === '/' ? 'is-active' : '' %>" href="/">Кампании</a>
        <a class="nav-link <%= currentPath.startsWith('/settings') ? 'is-active' : '' %>" href="/settings">Настройки</a>
      </nav>
      <div class="topbar-user">
        <% if (typeof currentUsername !== 'undefined' && currentUsername) { %>
          <span class="user-chip"><%= currentUsername %></span>
          <form method="post" action="/logout" class="m-0">
            <button class="btn-ghost">Выйти</button>
          </form>
        <% } %>
      </div>
    </div>
    <div class="topbar-rule"></div>
  </header>
  <main class="container page">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="alert alert-info"><%= flash %></div>
    <% } %>
    <%- body %>
  </main>
</body>
</html>
