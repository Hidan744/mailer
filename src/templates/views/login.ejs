<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Вход — Рассылка писем</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Yeseva+One&family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/app.css" />
  <style>
    body {
      min-height: 100vh;
      background: var(--green);
      background-image:
        radial-gradient(ellipse at top left, rgba(201, 160, 79, 0.22), transparent 55%),
        repeating-linear-gradient(0deg, rgba(243,236,216,0.025) 0px, rgba(243,236,216,0.025) 1px, transparent 1px, transparent 34px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .login-card {
      width: 100%;
      max-width: 380px;
      background: var(--paper-card);
      border-radius: var(--radius);
      box-shadow: 0 20px 60px rgba(0,0,0,0.35);
      padding: 2.5rem 2.25rem 2.25rem;
      position: relative;
    }
    .login-card::before {
      content: "";
      position: absolute;
      inset: 10px;
      border: 1px solid var(--rule);
      pointer-events: none;
    }
    .login-mark {
      width: 3rem; height: 3rem;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: "Yeseva One", serif;
      font-weight: 400;
      font-size: 1.4rem;
      color: var(--accent);
      background: transparent;
      border: 1px solid var(--accent);
      margin: 0 auto 1rem;
    }
    .login-title {
      font-family: "Yeseva One", serif;
      text-align: center;
      font-size: 1.5rem;
      font-weight: 400;
      letter-spacing: 0.01em;
      margin-bottom: 0.15rem;
    }
    .login-sub {
      text-align: center;
      color: var(--ink-faint);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1.75rem;
    }
    .login-card .btn-primary { width: 100%; padding: 0.65rem; margin-top: 0.5rem; }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="login-mark">№</div>
    <div class="login-title">Рассылка писем</div>
    <div class="login-sub">Вход для операторов</div>
    <% if (error) { %>
      <div class="alert alert-danger py-2 px-3 small"><%= error %></div>
    <% } %>
    <form method="post" action="/login">
      <input type="hidden" name="next" value="<%= next %>" />
      <div class="mb-3">
        <label class="form-label">Логин</label>
        <input class="form-control" name="username" required autofocus />
      </div>
      <div class="mb-3">
        <label class="form-label">Пароль</label>
        <input class="form-control" type="password" name="password" required />
      </div>
      <button class="btn btn-primary">Войти</button>
    </form>
  </div>
</body>
</html>
